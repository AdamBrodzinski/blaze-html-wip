{
  "permissions": {
    "allow": [
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "WebFetch(domain:docs.rs)",
      "Bash(cargo doc:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo check:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(wc:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo run:*)",
      "Bash(cat:*)",
      "Bash(RUST_BACKTRACE=1 cargo bench:*)",
      "mcp__context7__query-docs",
      "Bash(cargo clippy:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(echo \"EXIT: $?\")",
      "Bash(cargo build *)",
      "Read(//tmp/**)",
      "Bash(echo \"EXIT=$?\")"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cargo lint"
          }
        ]
      }
    ]
  }
}
